# ============================================================
# AirPulse — Environment Variables
# Copy this file to .env and fill in real values.
# Never commit .env to version control!
# ============================================================

# ── Phase 1: Data Ingestion ─────────────────────────────────
OPENAQ_API_KEY=your_openaq_api_key_here         # Register at explore.openaq.org

# ── Phase 1: AWS / S3 ──────────────────────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_DEFAULT_REGION=ap-south-1
S3_BUCKET_RAW=airpulse-raw

# ── Phase 2: MLflow ────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_S3_ENDPOINT_URL=                          # Leave empty for real AWS S3
MLFLOW_ARTIFACT_ROOT=s3://airpulse-mlflow/artifacts

# ── Phase 3: Serving ───────────────────────────────────────
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
MODEL_STAGE=Production                           # MLflow model stage to serve

# ── Phase 4: CI/CD ─────────────────────────────────────────
GHCR_TOKEN=                                      # GitHub Container Registry PAT
ORACLE_VM_HOST=                                   # Oracle Cloud VM IP/hostname
ORACLE_VM_USER=ubuntu
ORACLE_VM_SSH_KEY_PATH=~/.ssh/oracle_vm_key

# ── Phase 5: Monitoring ────────────────────────────────────
DRIFT_THRESHOLD=0.05                             # Evidently drift p-value threshold
RETRAIN_SCHEDULE_CRON=0 3 * * 0                  # Weekly retraining (Sunday 3 AM)

# ── Phase 6: Orchestration ─────────────────────────────────
K3S_KUBECONFIG_PATH=~/.kube/config
GRAFANA_ADMIN_PASSWORD=                          # Grafana dashboard password
